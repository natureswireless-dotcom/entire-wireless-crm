DATA_DIR=./data
PUBLIC_URL=http://127.0.0.1:8000
COOKIE_SECURE=0
SECRET_KEY=replace-with-a-long-random-value
ADMIN_EMAIL=admin@natureswireless.org
ADMIN_PASSWORD=replace-this-password
COMPANY_NAME=Entire Wireless
COMPANY_LEGAL=Natures Wireless LLC
COMPANY_SITE=https://natureswireless.org
COMPANY_PHONE=(815) 694-WIRE
COMPANY_ADDRESS=35412 N 770 East Rd, Rossville, IL 60963
SUPPORT_EMAIL=support@natureswireless.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@natureswireless.org
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RECONNECT_FEE=25.00
SUSPEND_AFTER_DAYS=3
VERIZON_ENABLED=0
VERIZON_DRY_RUN=1
VERIZON_ACCOUNT_NAME=
VERIZON_APP_KEY=
VERIZON_APP_SECRET=
VERIZON_UWS_USERNAME=
VERIZON_UWS_PASSWORD=
VERIZON_CALLBACK_TOKEN=

# v5 legal / DBA identity
COMPANY_DBA=Entire Wireless
COMPANY_DISPLAY_LEGAL=Natures Wireless LLC d/b/a Entire Wireless
BUSINESS_TIMEZONE=America/Chicago
BUSINESS_CLOSE_HOUR=17
PAST_DUE_REMINDER_DAYS=7
# Display identity shown in Carrier Control. VERIZON_ACCOUNT_NAME must still match the exact Verizon-assigned billing account value used by the API.
VERIZON_ACCOUNT_DISPLAY_NAME=Natures Wireless LLC d/b/a Entire Wireless

# v5.2 customer billing fees
UNRETURNED_EQUIPMENT_FEE=700.00
EARLY_TERMINATION_MONTHLY_FEE=20.00
SIM_REPLACEMENT_FEE=5.00

# Employee password policy (v5.5)
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_HISTORY_COUNT=3

# QuickBooks Online (v8.0)
QUICKBOOKS_ENABLED=0
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://crm.natureswireless.org/quickbooks/callback

# QuickBooks production resilience (v8.1)
QUICKBOOKS_API_TIMEOUT=90
QUICKBOOKS_API_RETRIES=2

# Accounting provider selector (v9.0)
# Values: zoho, quickbooks, none
ACCOUNTING_PROVIDER=zoho

# Zoho Books (v9.0)
ZOHO_ENABLED=0
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=https://crm.natureswireless.org/zoho/callback
# US data center defaults. Change only if the Zoho account is hosted in another data center.
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_API_TIMEOUT=60
ZOHO_API_RETRIES=2
ZOHO_SCOPES=ZohoBooks.settings.ALL,ZohoBooks.contacts.ALL,ZohoBooks.invoices.ALL,ZohoBooks.customerpayments.ALL

# Accounting navigation/safety (v9.1)
# 0 = show only the active provider in the main sidebar; 1 = show both provider links.
ACCOUNTING_SHOW_INACTIVE=0

# WooCommerce storefront integration (v10.2)
WOOCOMMERCE_ENABLED=0
WOOCOMMERCE_STORE_URL=https://natureswireless.org
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=
WOOCOMMERCE_ACTIVATION_FEE=25.00
